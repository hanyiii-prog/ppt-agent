{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hanyiii-prog/ppt-agent/blob/main/ir/presentation.schema.json",
  "title": "PPT Agent Universal Presentation IR",
  "type": "object",
  "required": ["version", "metadata", "slides"],
  "properties": {
    "ir_version": {
      "type": "string",
      "description": "Stable IR contract version this document conforms to",
      "enum": ["0.1", "1.0"]
    },
    "version": {"type": "string", "description": "IR dialect marker (kept in sync with ir_version)"},
    "metadata": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": {"type": "string"},
        "author": {"type": "string"},
        "audience": {"type": "string"},
        "objective": {"type": "string"},
        "ir_version": {"type": "string"}
      },
      "additionalProperties": true
    },
    "theme": {"type": "object", "additionalProperties": true},
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    },
    "slides": {
      "type": "array",
      "items": {"$ref": "#/$defs/slide"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "uri"],
      "properties": {
        "id": {"type": "string"},
        "uri": {"type": "string"},
        "label": {"type": "string"}
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["source_id"],
      "properties": {
        "source_id": {"type": "string"},
        "locator": {"type": "string"},
        "quote": {"type": "string"}
      },
      "additionalProperties": true
    },
    "component": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string"},
        "id": {"type": "string"},
        "x": {"type": "number"},
        "y": {"type": "number"},
        "w": {"type": "number"},
        "h": {"type": "number"},
        "text": {"type": "string"},
        "data": {},
        "style": {"type": "object", "additionalProperties": true},
        "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenance"}}
      },
      "additionalProperties": true
    },
    "slide": {
      "type": "object",
      "required": ["id", "purpose", "components"],
      "properties": {
        "id": {"type": "string"},
        "purpose": {"type": "string"},
        "claim": {"type": "string"},
        "layout": {"type": "string"},
        "components": {"type": "array", "items": {"$ref": "#/$defs/component"}},
        "speaker_notes": {"type": "string"},
        "data": {}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
